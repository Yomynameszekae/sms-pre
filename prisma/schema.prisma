model File {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  ownerType FileOwnerType @map("owner_type")
  ownerId   String?       @map("owner_id") @db.Uuid

  category String? @db.VarChar(80)

  originalFileName String  @map("original_file_name") @db.VarChar(255)
  storedFileName   String? @map("stored_file_name") @db.VarChar(255)
  mimeType         String  @map("mime_type") @db.VarChar(120)
  sizeBytes        BigInt  @map("size_bytes")

  storageBucket String  @map("storage_bucket") @db.VarChar(150)
  storageKey    String  @map("storage_key")
  publicUrl     String? @map("public_url")

  checksumSha256 String? @map("checksum_sha256") @db.VarChar(100)

  isPublic   Boolean   @default(false) @map("is_public")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  uploadedBy String? @map("uploaded_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  school         School @relation(fields: [schoolId], references: [id])
  uploadedByUser User?  @relation("UploadedFiles", fields: [uploadedBy], references: [id])

  @@index([schoolId])
  @@index([ownerType, ownerId])
  @@index([category])
  @@index([uploadedBy])
  @@index([archivedAt])
